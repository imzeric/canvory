{
  "name": "canvory",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier -w .",
    "validate:quickstart": "tsx scripts/validate-quickstart.mts",
    "validate:sc-rates": "tsx scripts/sc-rates.mts",
    "validate:sc003": "tsx scripts/sc003-measure.mts",
    "validate:pptx-smoke": "tsx scripts/pptx-structure-smoke.mts",
    "validate:rm03": "pnpm --filter @canvory/server exec tsx scripts/rm03-infra-verify.mts"
  },
  "dependencies": {
    "@canvory/core": "workspace:*",
    "@canvory/document-model": "workspace:*",
    "@canvory/exporter-pptx": "workspace:*",
    "@canvory/renderer-web-min": "workspace:*",
    "@canvory/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
