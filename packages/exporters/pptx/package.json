{
  "name": "@canvory/exporter-pptx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "export-file": "node --import tsx scripts/export-file.ts"
  },
  "dependencies": {
    "@canvory/core": "workspace:*",
    "@canvory/document-model": "workspace:*",
    "@canvory/shared": "workspace:*",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
