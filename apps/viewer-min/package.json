{
  "name": "@canvory/viewer-min",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/serve.ts",
    "render": "tsx src/cli.ts"
  },
  "dependencies": {
    "@canvory/document-model": "workspace:*",
    "@canvory/renderer-web-min": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
